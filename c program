#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{
    char s[100];
    
    // Read a full line of input from stdin and save it to our variable s
    scanf("%[^\n]%*c", &s);
    
    // Print Hello, World! on the first line
    printf("Hello, World!\n");
    
    // Print the input string s on the second line
    printf("%s", s);
    
    return 0;
}
